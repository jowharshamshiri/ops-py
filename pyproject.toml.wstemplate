[build-system]
requires = ["setuptools>=61.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "opsx-py"
version = "{{ project.version }}"
description = "A Python ops framework with composable wrappers and batch execution"
authors = [{name = "https://github.com/jowharshamshiri"}]
license = {text = "MIT"}
requires-python = ">=3.10"
dependencies = [
    "jsonschema>=4.0.0",
]

[project.optional-dependencies]
dev = [
    "pytest>=7.0",
    "pytest-asyncio>=0.21",
    "pytest-cov>=4.0",
]

[dependency-groups]
# What dx publish checks and uploads the built artifacts with.
release = [
    "twine>=6.0",
]

[tool.uv]
# The suite runs against src/ with only the dependencies installed, so uv
# builds nothing into the source tree.
package = false

[tool.setuptools.packages.find]
where = ["src"]

[tool.pytest.ini_options]
testpaths = ["tests"]
python_files = ["test_*.py"]
python_functions = ["test_*"]
asyncio_mode = "auto"
